Options -Indexes
Options -FollowSymLinks

# Deny direct access to view files
<FilesMatch "\.php$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Allow only index.php and login.php as entry points
<FilesMatch "^(?!index|login).*\.php$">
    RewriteEngine On
    RewriteRule ^ index.php [L,R=403]
</FilesMatch>

# Disable script execution in assets
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|ico|woff|woff2|ttf|svg)$">
    Header set X-Content-Type-Options "nosniff"
</FilesMatch>

# Security headers
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-XSS-Protection "1; mode=block"
